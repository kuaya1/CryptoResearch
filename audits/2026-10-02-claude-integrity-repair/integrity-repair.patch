diff --git b/dashboard/tests/children/child-held-commit.js b/dashboard/tests/children/child-held-commit.js
new file mode 100644
index 0000000..3c2f568
--- /dev/null
+++ b/dashboard/tests/children/child-held-commit.js
@@ -0,0 +1,39 @@
+'use strict';
+// Test child for coherent reads (audit V2-001). Commits several files in one
+// operation and stops after the first one has been moved into place:
+//   hold   writes <ready>, then waits until <release> exists, then finishes
+//   timed  writes <ready>, waits <hold_ms>, then finishes
+//   crash  writes <ready>, then the process is killed (no cleanup runs)
+// Usage: node child-held-commit.js <root> <spec.json>
+// spec: { writes: [{ rel, content }], after: rel, mode, ready, release, hold_ms }
+const fs = require('fs');
+const path = require('path');
+const base = path.resolve(__dirname, '..', '..');
+const [root, specFile] = process.argv.slice(2);
+const spec = JSON.parse(fs.readFileSync(specFile, 'utf8'));
+const ops = require(path.join(base, 'core', 'ops'));
+const { sleepSync } = require(path.join(base, 'core', 'fsx'));
+const ws = require(path.join(base, 'core', 'workspace')).openWorkspace({ root, actor: 'held-writer' });
+
+const target = path.resolve(ws.abs(spec.after));
+const rename = fs.renameSync;
+let stopped = false;
+fs.renameSync = function heldRename(from, to) {
+  const r = rename.call(fs, from, to);
+  if (!stopped && String(from).includes(`${path.sep}staging${path.sep}`) && path.resolve(String(to)) === target) {
+    stopped = true;
+    fs.writeFileSync(spec.ready, String(process.pid));
+    if (spec.mode === 'crash') process.kill(process.pid, 'SIGKILL');
+    if (spec.mode === 'timed') sleepSync(spec.hold_ms || 2000);
+    if (spec.mode === 'hold') {
+      const until = Date.now() + 60000;
+      while (!fs.existsSync(spec.release) && Date.now() < until) sleepSync(20);
+    }
+  }
+  return r;
+};
+
+const out = ops.runOp(ws, { type: 'held_test', summary: 'held two-file commit' }, (op) => {
+  for (const w of spec.writes) op.write(w.rel, w.content);
+});
+process.stdout.write(JSON.stringify({ verified: out.verified, op_id: out.op_id }));
diff --git b/dashboard/tests/children/child-research-runner.js b/dashboard/tests/children/child-research-runner.js
new file mode 100644
index 0000000..ad539aa
--- /dev/null
+++ b/dashboard/tests/children/child-research-runner.js
@@ -0,0 +1,53 @@
+'use strict';
+// Test child for paid research attempts (audit V2-003/004). Runs the research
+// runner once against a TEST workspace. Provider URLs are rewritten to a local
+// stub server; any other URL is refused, so nothing leaves this PC. The keys in
+// the environment are fake test values.
+// Usage: node child-research-runner.js <root> <config.json>
+// config: { stub_port, crash: { op, when: 'before'|'after' } | null,
+//           barrier: <file to wait for> | null, calls_dir: <dir> | null }
+// A crash kills the process at that point: no finally block or cleanup runs.
+const fs = require('fs');
+const path = require('path');
+const base = path.resolve(__dirname, '..', '..');
+const [root, configFile] = process.argv.slice(2);
+const cfg = JSON.parse(fs.readFileSync(configFile, 'utf8'));
+const { sleepSync } = require(path.join(base, 'core', 'fsx'));
+
+const die = () => process.kill(process.pid, 'SIGKILL');
+const ops = require(path.join(base, 'core', 'ops'));
+const runOp = ops.runOp;
+ops.runOp = function crashableRunOp(ws, meta, build) {
+  if (cfg.crash && cfg.crash.op === meta.type && cfg.crash.when === 'before') die();
+  const out = runOp.call(this, ws, meta, build);
+  if (cfg.crash && cfg.crash.op === meta.type && cfg.crash.when === 'after') die();
+  return out;
+};
+
+const research = require(path.join(base, 'core', 'research'));
+const ws = require(path.join(base, 'core', 'workspace')).openWorkspace({ root, actor: 'runner-child' });
+
+const ROUTES = [
+  ['https://api.anthropic.com/', '/anthropic/'],
+  ['https://api.openai.com/', '/openai/'],
+  ['https://generativelanguage.googleapis.com/', '/gemini/'],
+];
+async function fetchImpl(url, opts) {
+  const hit = ROUTES.find(([from]) => String(url).startsWith(from));
+  if (!hit) throw new Error(`test child refused a request to ${url}`);
+  if (cfg.calls_dir) fs.writeFileSync(path.join(cfg.calls_dir, `${process.pid}-${Date.now()}-${Math.random().toString(36).slice(2)}.call`), String(url));
+  if (cfg.crash && cfg.crash.op === 'fetch' && cfg.crash.when === 'before') die();
+  return fetch(`http://127.0.0.1:${cfg.stub_port}${hit[1]}${String(url).slice(hit[0].length)}`, opts);
+}
+
+(async () => {
+  if (cfg.barrier) {
+    const until = Date.now() + 30000;
+    while (!fs.existsSync(cfg.barrier) && Date.now() < until) sleepSync(5);
+  }
+  const out = await research.runDueJobs(ws, { trigger: 'test-child', fetchImpl });
+  process.stdout.write(JSON.stringify(out));
+})().catch((err) => {
+  process.stdout.write(JSON.stringify({ error: err.message, code: err.code || null }));
+  process.exitCode = 3;
+});
diff --git b/dashboard/tests/integrity-reads.test.js b/dashboard/tests/integrity-reads.test.js
new file mode 100644
index 0000000..b30c3cf
--- /dev/null
+++ b/dashboard/tests/integrity-reads.test.js
@@ -0,0 +1,367 @@
+'use strict';
+// Coherent reads (audit V2-001). A second process commits two project records
+// in one operation and is held, killed or slowed after the first file moved.
+// Readers use the production defaults (READ_WAIT_MS, the server's own wait):
+// they return one whole generation, wait and then say busy, or refuse an
+// interrupted or unverified commit. They never return a mixed pair and never
+// turn a failed read into an empty result.
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('fs');
+const os = require('os');
+const path = require('path');
+const http = require('http');
+const cp = require('child_process');
+const { tempWorkspace, addFixtureProject } = require('./helpers');
+const ops = require('../core/ops');
+const indexer = require('../core/indexer');
+const exporter = require('../core/exporter');
+const projects = require('../core/projects');
+const { ymdInTz } = require('../core/dates');
+const { readJson, atomicWrite, jsonText } = require('../core/fsx');
+const { start } = require('../server');
+
+const CHILD = path.join(__dirname, 'children', 'child-held-commit.js');
+const PORT = 48000 + Math.floor(Math.random() * 400);
+const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
+
+async function waitFor(fn, timeoutMs = 15000, what = 'condition') {
+  const until = Date.now() + timeoutMs;
+  for (;;) {
+    const v = await fn();
+    if (v) return v;
+    if (Date.now() > until) throw new Error(`timed out waiting for ${what}`);
+    await sleep(20);
+  }
+}
+
+// Two projects, A and B. The held commit renames both: "A new" and "B new".
+function twoProjects(ws) {
+  const a = addFixtureProject(ws).project_id;
+  const b = projects.addProject(ws, { name: 'Second Example (FICTIONAL)', symbol: 'XSEC', coingecko_id: 'second-example-fictional', official_website: 'https://example.org/xsec', evidence: [{ url: 'https://example.org/xsec', note: 'fictional test evidence' }], sector_profile: 'payfi-credit@1' }).project_id;
+  assert.notEqual(a, b, 'two distinct projects');
+  return [a, b];
+}
+
+function heldCommit(ws, ids, mode, extra = {}) {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'cr-held-'));
+  const ready = path.join(dir, 'ready');
+  const release = path.join(dir, 'release');
+  const writes = ids.map((id, i) => {
+    const rel = `projects/${id}/project.json`;
+    const doc = readJson(ws.abs(rel));
+    doc.name = `${i ? 'B' : 'A'} new`;
+    return { rel, content: jsonText(doc) };
+  });
+  const spec = path.join(dir, 'spec.json');
+  fs.writeFileSync(spec, JSON.stringify({ writes, after: writes[0].rel, mode, ready, release, ...extra }));
+  const child = cp.spawn(process.execPath, [CHILD, ws.root, spec], { stdio: ['ignore', 'pipe', 'pipe'] });
+  let out = '';
+  let err = '';
+  child.stdout.on('data', (d) => { out += d; });
+  child.stderr.on('data', (d) => { err += d; });
+  const done = new Promise((resolve) => child.on('exit', (code, signal) => resolve({ code, signal, out, err })));
+  return {
+    child,
+    done,
+    ready: () => waitFor(() => fs.existsSync(ready), 15000, 'the writer to stop mid-commit'),
+    release: () => fs.writeFileSync(release, 'go'),
+    cleanup: () => fs.rmSync(dir, { recursive: true, force: true }),
+  };
+}
+
+const names = (ws, ids) => ids.map((id) => readJson(ws.abs(`projects/${id}/project.json`)).name);
+
+// Runs a read and reports what it did: a value or an error.
+function attempt(fn) {
+  try {
+    return { value: fn() };
+  } catch (error) {
+    return { error };
+  }
+}
+
+test('V2-001 held writer: readers at the production default wait, then say busy; never a mixed pair', async (t) => {
+  const { ws, cleanup } = tempWorkspace('v2001-held');
+  t.after(cleanup);
+  const ids = twoProjects(ws);
+  const before = names(ws, ids);
+  const w = heldCommit(ws, ids, 'hold');
+  t.after(w.cleanup);
+  await w.ready();
+  // The window is real: the raw files are mixed right now.
+  assert.deepEqual(names(ws, ids), ['A new', before[1]], 'raw read is mixed while the commit is held');
+  let t0 = Date.now();
+  const read = attempt(() => ops.readConsistent(ws, () => names(ws, ids)));
+  const waited = Date.now() - t0;
