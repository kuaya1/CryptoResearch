+'use strict';
+// Restore path safety (audit V2-002). Package and backup manifests are
+// untrusted input: an entry can carry a correct SHA-256 and still name a path
+// outside the destination. Every path is checked before anything is written,
+// nothing partial is left behind, and legitimate round trips still verify.
+// Every destination is nested three folders deep inside a throwaway sandbox,
+// so even code without these checks could only write inside the sandbox.
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('fs');
+const os = require('os');
+const path = require('path');
+const crypto = require('crypto');
+const { addFixtureProject } = require('./helpers');
+const exporter = require('../core/exporter');
+const { readJson, jsonText, atomicWrite } = require('../core/fsx');
+const { initWorkspace, openWorkspace, DEFAULT_ROOT } = require('../core/workspace');
+
+const sha = (b) => crypto.createHash('sha256').update(b).digest('hex');
+
+// A TEST workspace nested two folders inside its own sandbox, so a path that
+// escaped the workspace (or a restore target) would still land in the sandbox.
+function nestedWorkspace(t, label) {
+  const sbx = fs.mkdtempSync(path.join(os.tmpdir(), `cr-restore-ws-${label}-`));
+  t.after(() => fs.rmSync(sbx, { recursive: true, force: true }));
+  const root = path.join(sbx, 'n1', 'n2', 'ws');
+  fs.mkdirSync(root, { recursive: true });
+  initWorkspace(root, { kind: 'test', name: `test ${label}`, templatesFrom: path.join(DEFAULT_ROOT, 'templates') });
+  atomicWrite(path.join(root, 'config', 'settings.json'), jsonText({ schema_version: 1, market_data: { enabled: false }, inbox: { settle_seconds: 0 }, requests: { settle_seconds: 0 } }));
+  return { ws: openWorkspace({ root, actor: 'test' }), sbx };
+}
+
+function sandbox(t) {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'cr-restore-sbx-'));
+  t.after(() => fs.rmSync(root, { recursive: true, force: true }));
+  const dest = path.join(root, 'l1', 'l2', 'dest');
+  fs.mkdirSync(path.dirname(dest), { recursive: true });
+  return { root, dest };
+}
+
+// Every file anywhere in the sandbox, so an escape is seen wherever it lands.
+function listAll(dir) {
+  const out = [];
+  const walk = (d) => {
+    for (const e of fs.readdirSync(d, { withFileTypes: true })) {
+      const p = path.join(d, e.name);
+      if (e.isDirectory()) walk(p);
+      else out.push(path.relative(dir, p));
+    }
+  };
+  if (fs.existsSync(dir)) walk(dir);
+  return out.sort();
+}
+
+function withEntry(pkg, rel, content = 'payload') {
+  const copy = JSON.parse(JSON.stringify(pkg));
+  copy.files.push({ path: rel, bytes: Buffer.byteLength(content), sha256: sha(Buffer.from(content)), encoding: 'utf8', content });
+  return copy;
+}
+
+const HOSTILE = [
+  ['backslash traversal', '..\\escaped.txt'],
+  ['slash traversal', '../escaped.txt'],
+  ['traversal inside a path', 'projects/../../escaped.txt'],
+  ['trailing space folds to ..', '.. /escaped.txt'],
+  ['trailing dots fold to ..', '.../escaped.txt'],
+  ['trailing dot name', 'projects/report.'],
+  ['absolute (POSIX)', '/abs-escaped.txt'],
+  ['drive absolute', 'C:\\escaped.txt'],
+  ['drive relative', 'C:escaped.txt'],
+  ['UNC', '\\\\server\\share\\escaped.txt'],
+  ['UNC with slashes', '//server/share/escaped.txt'],
+  ['rooted', '\\rooted-escaped.txt'],
+  ['NUL byte', 'projects/x\u0000.txt'],
+  ['control character', 'projects/x\u0007.txt'],
+  ['reserved device name', 'projects/CON.txt'],
+  ['reserved device name with superscript', 'projects/COM\u00b9.json'],
+  ['alternate data stream', 'projects/notes.txt:hidden'],
+  ['empty segment', 'projects//x.txt'],
+];
+
+test('V2-002 package: every hostile path is refused before anything is written, even with a valid hash', (t) => {
+  const { ws } = nestedWorkspace(t, 'pkg');
+  addFixtureProject(ws);
+  const pkg = exporter.exportPackage(ws);
+  for (const [label, rel] of HOSTILE) {
+    const { root, dest } = sandbox(t);
+    const before = listAll(root);
+    assert.throws(() => exporter.restorePackage(withEntry(pkg, rel), dest), (e) => e.code === 'UNSAFE_PATH' && /SHA-256 only ties bytes/.test(e.message), label);
+    assert.equal(fs.existsSync(dest), false, `${label}: no destination folder was created`);
+    assert.deepEqual(listAll(root), before, `${label}: nothing was written anywhere in the sandbox`);
+  }
+});
+
+test('V2-002 package: duplicate targets and file/folder conflicts are refused as a whole', (t) => {
+  const { ws } = nestedWorkspace(t, 'dup');
+  addFixtureProject(ws);
+  const pkg = exporter.exportPackage(ws);
+  const cases = [
+    ['same name, different case', ['notes/Readme.txt', 'notes/README.txt']],
+    ['same name, different Unicode form', ['notes/caf\u00e9.txt', 'notes/cafe\u0301.txt']],
+    ['a file where a folder is needed', ['notes/x', 'notes/x/y.txt']],
+  ];
+  for (const [label, rels] of cases) {
+    const { root, dest } = sandbox(t);
+    let p = pkg;
+    rels.forEach((r, i) => { p = withEntry(p, r, `content ${i}`); });
+    assert.throws(() => exporter.restorePackage(p, dest), (e) => e.code === 'UNSAFE_PATH', label);
+    assert.equal(fs.existsSync(dest), false, label);
+    assert.deepEqual(listAll(root), [], label);
+  }
+});
+
+test('V2-002 package: a damaged last entry, or a write failure part way, leaves no partial destination', (t) => {
+  const { ws } = nestedWorkspace(t, 'late');
+  addFixtureProject(ws);
+  const pkg = exporter.exportPackage(ws);
+  assert.ok(pkg.files.length > 5);
+  // Damaged entry at the end: refused before the first file is written.
+  const damaged = JSON.parse(JSON.stringify(pkg));
+  const last = damaged.files[damaged.files.length - 1];
+  last.content = last.encoding === 'base64' ? Buffer.from('tampered').toString('base64') : `${last.content} tampered`;
+  let sb = sandbox(t);
+  assert.throws(() => exporter.restorePackage(damaged, sb.dest), (e) => e.code === 'INVALID' && /damaged/.test(e.message));
+  assert.equal(fs.existsSync(sb.dest), false);
+  // A write that fails after some files were written: everything is removed.
+  sb = sandbox(t);
+  const fsync = fs.fsyncSync;
+  let n = 0;
+  fs.fsyncSync = function failing(fd) {
+    if (++n === 4) throw Object.assign(new Error('simulated disk failure'), { code: 'EIO' });
+    return fsync.call(fs, fd);
+  };
+  try {
+    assert.throws(() => exporter.restorePackage(pkg, sb.dest), /simulated disk failure/);
+  } finally {
+    fs.fsyncSync = fsync;
+  }
+  assert.ok(n >= 4, 'the failure happened after earlier files were written');
+  assert.equal(fs.existsSync(sb.dest), false, 'the partly written destination was removed');
+  // A non-empty destination is refused and left as it was.
+  sb = sandbox(t);
+  fs.mkdirSync(sb.dest, { recursive: true });
+  fs.writeFileSync(path.join(sb.dest, 'mine.txt'), 'keep me');
+  assert.throws(() => exporter.restorePackage(pkg, sb.dest), /not an empty folder/);
+  assert.deepEqual(fs.readdirSync(sb.dest), ['mine.txt']);
+});
+
+test('V2-002 package and backup: legitimate round trips still restore and verify', (t) => {
+  const { ws } = nestedWorkspace(t, 'ok');
+  addFixtureProject(ws);
+  const pkg = exporter.exportPackage(ws);
+  let sb = sandbox(t);
+  const r = exporter.restorePackage(JSON.parse(JSON.stringify(pkg)), sb.dest);
+  assert.equal(r.status, 'restored_and_verified', JSON.stringify(r.reconciliation));
+  for (const f of pkg.files) assert.equal(sha(fs.readFileSync(path.join(sb.dest, ...f.path.split('/')))), f.sha256, f.path);
+  const b = exporter.createBackup(ws, { reason: 'roundtrip' });
+  assert.equal(exporter.verifyBackup(ws, b.name).ok, true);
+  sb = sandbox(t);
+  const rb = exporter.restoreBackupTo(ws, b.name, sb.dest);
+  assert.equal(rb.status, 'restored_and_verified', JSON.stringify(rb.reconciliation));
+});
+
+test('V2-002 restores say whether the records were verified when the package or backup was made', (t) => {
+  const { ws } = nestedWorkspace(t, 'okv');
+  addFixtureProject(ws);
+  let sb = sandbox(t);
+  assert.equal(exporter.restorePackage(exporter.exportPackage(ws), sb.dest).consistency_when_packaged.verified, true);
+  const b = exporter.createBackup(ws, { reason: 'roundtrip' });
+  sb = sandbox(t);
+  assert.equal(exporter.restoreBackupTo(ws, b.name, sb.dest).records_verified_when_taken, true);
+});
+
+// Adds an item to a sealed backup and reseals it, as anyone with write access
+// to the backup folder could. The payload sits where the item path resolves.
+function resealWith(ws, name, rel, content) {
+  const dir = ws.abs(`backups/snapshots/${name}`);
+  const mf = path.join(dir, 'MANIFEST.json');
+  const m = readJson(mf);
+  const buf = Buffer.from(content);
+  const src = path.join(dir, 'files', rel.replace(/[\\/]/g, path.sep));
+  fs.mkdirSync(path.dirname(src), { recursive: true });
+  try { fs.writeFileSync(src, buf); } catch (_) { /* some names cannot be created; the manifest still lists them */ }
+  m.items.push({ path: rel, bytes: buf.length, sha256: sha(buf) });
+  m.seal = sha(JSON.stringify(m.items.map((i) => [i.path, i.bytes, i.sha256])));
+  fs.writeFileSync(mf, jsonText(m));
+}
+
+test('V2-002 backup: a resealed manifest with a traversal path is refused by verify and every restore mode', (t) => {
+  const { ws, sbx } = nestedWorkspace(t, 'bk');
+  addFixtureProject(ws);
+  const b = exporter.createBackup(ws, { reason: 'base' });
+  resealWith(ws, b.name, '..\\escaped.txt', 'payload');
+  const v = exporter.verifyBackup(ws, b.name);
+  assert.equal(v.ok, false);
+  assert.ok(v.unsafe_paths && v.unsafe_paths.some((x) => x.path === '..\\escaped.txt'), JSON.stringify(v));
+  const { root, dest } = sandbox(t);
+  assert.throws(() => exporter.restoreBackupTo(ws, b.name, dest), (e) => e.code === 'UNSAFE_PATH');
+  assert.equal(fs.existsSync(dest), false);
+  assert.deepEqual(listAll(root), []);
+  const snapshotsBefore = fs.readdirSync(ws.abs('backups/snapshots')).sort();
+  assert.throws(() => exporter.restoreBackupOverlay(ws, b.name, { confirm: true }), (e) => e.code === 'UNSAFE_PATH');
+  assert.deepEqual(fs.readdirSync(ws.abs('backups/snapshots')).sort(), snapshotsBefore, 'refused before the pre-restore backup');
+  assert.throws(() => exporter.restoreBackupPointInTime(ws, b.name, { confirm: true }), (e) => e.code === 'UNSAFE_PATH');
+  assert.deepEqual(listAll(sbx).filter((f) => /escaped\.txt$/.test(f) && !f.includes(`${path.sep}backups${path.sep}`)), [], 'no escaped file anywhere outside the backup folder');
+});
+
+test('V2-002 backup: a junction inside the files folder that leads outside is not followed', (t) => {
+  const { ws } = nestedWorkspace(t, 'link');
+  addFixtureProject(ws);
+  const b = exporter.createBackup(ws, { reason: 'base' });
+  const { root, dest } = sandbox(t);
+  // Replace files/portfolio with a junction to a folder outside the backup
+  // that holds byte-identical copies, so every recorded hash still matches.
+  const filesPortfolio = ws.abs(`backups/snapshots/${b.name}/files/portfolio`);
+  const outside = path.join(root, 'outside-portfolio');
+  fs.cpSync(filesPortfolio, outside, { recursive: true });
+  fs.rmSync(filesPortfolio, { recursive: true, force: true });
+  fs.symlinkSync(outside, filesPortfolio, 'junction');
+  const v = exporter.verifyBackup(ws, b.name);
+  assert.equal(v.ok, false);
+  assert.ok((v.escaped && v.escaped.length) || (v.links && v.links.length), JSON.stringify({ escaped: v.escaped, links: v.links }));
+  assert.throws(() => exporter.restoreBackupTo(ws, b.name, dest), (e) => e.code === 'INVALID');
+  assert.equal(fs.existsSync(dest), false);
+});
diff --git b/dashboard/tests/live-updates.test.js b/dashboard/tests/live-updates.test.js
new file mode 100644
index 0000000..f9bbea8
--- /dev/null
+++ b/dashboard/tests/live-updates.test.js
@@ -0,0 +1,85 @@
+'use strict';
+// Bounded live updates (audit V2-006), server side. Pages ask GET /api/version
+// while visible instead of holding an event stream open. This checks what
+// that endpoint promises: a small answer, a sequence that moves only when the
+// served index changes, the projects that changed, a fresh start after a gap
+// or a restart, and that many pollers hold no stream open. Browser behavior
+// (hidden pages, back/forward cache, seven windows) is checked in a browser.
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const http = require('http');
+const { tempWorkspace, addFixtureProject } = require('./helpers');
+const { start } = require('../server');
+const { ymdInTz } = require('../core/dates');
+const { atomicWrite, jsonText } = require('../core/fsx');
+
+const PORT = 48600 + Math.floor(Math.random() * 300);
+
+function request(port, { method = 'GET', path = '/', token, body = null, agent = undefined } = {}) {
+  return new Promise((resolve, reject) => {
+    const headers = { host: `127.0.0.1:${port}`, 'x-cr-token': token };
+    if (method === 'POST') Object.assign(headers, { origin: `http://127.0.0.1:${port}`, 'content-type': 'application/json' });
+    const req = http.request({ host: '127.0.0.1', port, method, path, headers, agent }, (res) => {
+      const chunks = [];
+      res.on('data', (c) => chunks.push(c));
+      res.on('end', () => {
+        const text = Buffer.concat(chunks).toString('utf8');
+        resolve({ status: res.statusCode, bytes: Buffer.byteLength(text), body: JSON.parse(text) });
+      });
+    });
+    req.on('error', reject);
+    if (body) req.write(JSON.stringify(body));
+    req.end();
+  });
+}
+
+test('V2-006 /api/version: small answers, a sequence that moves with the index, the projects that changed', async (t) => {
+  const { ws, cleanup } = tempWorkspace('v2006');
+  const pid = addFixtureProject(ws).project_id;
+  const today = ymdInTz(new Date());
+  atomicWrite(ws.abs('logs/jobs-state.json'), jsonText({ schema_version: 'cr.jobs-state.v1', jobs: { snapshot: { last_success_day: today }, reviews: { last_success_day: today }, backup: { last_success_day: today } }, runner: {} }));
+  let srv = await start(ws, { port: PORT, quiet: true });
+  t.after(() => {
+    try { srv.shutdown(); } catch (_) { /* stopped */ }
+    cleanup();
+  });
+  const idx = await request(srv.port, { path: '/api/index', token: srv.token });
+  assert.equal(idx.status, 200);
+  const { seq, instance } = idx.body.live;
+  assert.equal(typeof seq, 'number');
+  const v0 = await request(srv.port, { path: `/api/version?since=${seq}`, token: srv.token });
+  assert.equal(v0.status, 200);
+  assert.equal(v0.body.instance, instance);
+  assert.ok(v0.bytes < 2000, `a poll answer is small (${v0.bytes} bytes)`);
+  // Without the token: refused like every other API route.
+  const noToken = await request(srv.port, { path: '/api/version', token: 'wrong' });
+  assert.equal(noToken.status, 401);
+  // A write moves the sequence and names the project that changed.
+  const w = await request(srv.port, { method: 'POST', path: `/api/projects/${pid}/watchlist`, token: srv.token, body: { on: false } });
+  assert.equal(w.status, 200);
+  const v1 = await request(srv.port, { path: `/api/version?since=${seq}`, token: srv.token });
+  assert.ok(v1.body.seq > seq, 'the sequence moved');
+  assert.ok(v1.body.changes.some((c) => Array.isArray(c.projects) && c.projects.includes(pid)), JSON.stringify(v1.body.changes));
+  // Nothing changed since: an empty list, not a refetch.
+  const v2 = await request(srv.port, { path: `/api/version?since=${v1.body.seq}`, token: srv.token });
+  assert.deepEqual(v2.body.changes, []);
+  // A position the server does not know (a gap, or another server's): refetch everything.
+  const v3 = await request(srv.port, { path: `/api/version?since=${v1.body.seq + 1000}`, token: srv.token });
+  assert.equal(v3.body.changes, null);
+  // Twelve windows polling at once: every poll is answered and no stream stays open.
+  const agents = Array.from({ length: 12 }, () => new http.Agent({ keepAlive: true, maxSockets: 6 }));
+  for (let round = 0; round < 3; round++) {
+    const answers = await Promise.all(agents.map((agent) => request(srv.port, { path: `/api/version?since=${v1.body.seq}`, token: srv.token, agent })));
+    assert.ok(answers.every((a) => a.status === 200));
+  }
+  const stats = await request(srv.port, { path: '/api/server-stats', token: srv.token });
+  assert.equal(stats.body.event_streams_open, 0);
+  assert.ok(stats.body.requests['/api/version'] >= 36);
+  agents.forEach((a) => a.destroy());
+  // A restart is a new instance: pages refetch instead of trusting old positions.
+  srv.shutdown();
+  srv = await start(ws, { port: PORT + 20, quiet: true });
+  const v4 = await request(srv.port, { path: `/api/version?since=${v1.body.seq}`, token: srv.token });
+  assert.notEqual(v4.body.instance, instance);
+});
diff --git b/dashboard/tests/research-attempts.test.js b/dashboard/tests/research-attempts.test.js
new file mode 100644
index 0000000..ccb2871
--- /dev/null
+++ b/dashboard/tests/research-attempts.test.js
@@ -0,0 +1,336 @@
+'use strict';
+// Interrupted paid attempts (audit V2-003). A real runner process is killed at
+// each point of a paid attempt; a fresh runner process then continues. The
+// "provider" is a local stub server, so the number of requests that reached it
+// is counted where it happens. Keys are fake test values and every provider
+// URL is rewritten to 127.0.0.1: nothing leaves this PC.
+//
+// Windows and expected outcomes:
+//   1 after the reservation, before the dispatch marker  -> released, sent once on restart
+//   2 after the dispatch marker, before the request       -> uncertain, held (the ambiguous window)
+//   3 while the provider has the request                  -> uncertain, never resent by itself
+//   4 after the answer arrived, before it was saved       -> uncertain, never resent by itself
+//   5 after the answer and its pointer were saved          -> imported on restart, no new request
+//   6 an older runner's answer file without a pointer     -> validated and imported, no new request
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('fs');
+const os = require('os');
+const path = require('path');
+const http = require('http');
+const cp = require('child_process');
+const { tempWorkspace, addFixtureProject } = require('./helpers');
+const research = require('../core/research');
+const indexer = require('../core/indexer');
+const ops = require('../core/ops');
+const { mockReport } = require('../core/demo');
+const { readJson, atomicWrite, jsonText, readJsonLines, sha256 } = require('../core/fsx');
+const { openWorkspace } = require('../core/workspace');
+
+const CHILD = path.join(__dirname, 'children', 'child-research-runner.js');
+const FAKE_KEY = 'test-key-not-real-0000';
+
+function configure(root, research) {
+  const file = path.join(root, 'config', 'settings.json');
+  const s = readJson(file);
+  s.research = research;
+  atomicWrite(file, jsonText(s));
+  return openWorkspace({ root, actor: 'test' });
+}
+
+const CLAUDE = { model: 'claude-test-model', input_usd_per_mtok: 3, output_usd_per_mtok: 15, search_usd_per_call: 0.01, max_searches: 5 };
+
+function claudeAnswer(text, usage = {}) {
+  return { id: 'msg_stub_1', model: 'claude-test-model', stop_reason: 'end_turn', content: [{ type: 'text', text }], usage: { input_tokens: usage.input ?? 12000, output_tokens: usage.output ?? 3000, server_tool_use: { web_search_requests: usage.searches ?? 2 } } };
+}
+
+// A local stand-in for the provider. behavior(call) returns 'hang', 'reset',
+// or { status, json }.
+async function stubProvider() {
+  const calls = [];
+  const sockets = new Set();
+  let behavior = () => ({ status: 500, json: { error: { message: 'no behavior set' } } });
+  const server = http.createServer((req, res) => {
+    let body = '';
+    req.on('data', (d) => { body += d; });
+    req.on('end', () => {
+      const call = { path: req.url, body: body ? JSON.parse(body) : null, at: Date.now() };
+      calls.push(call);
+      server.emit('call', call);
+      const b = behavior(call);
+      if (b === 'hang') return;
+      if (b === 'reset') {
+        req.socket.destroy();
+        return;
+      }
+      res.writeHead(b.status, { 'content-type': 'application/json', 'request-id': 'req_stub_1' });
+      res.end(JSON.stringify(b.json));
+    });
+  });
+  server.on('connection', (s) => {
+    sockets.add(s);
+    s.on('close', () => sockets.delete(s));
+  });
+  await new Promise((resolve) => server.listen(0, '127.0.0.1', resolve));
+  return {
+    port: server.address().port,
+    calls,
+    server,
+    set(fn) { behavior = fn; },
+    close() {
+      for (const s of sockets) s.destroy();
+      server.close();
+    },
+  };
+}
+
+// One runner process. crash: { op, when } kills it at that point; killOnCall
+// kills it as soon as the stub receives a request.
+function runner(root, stub, { crash = null, killOnCall = false } = {}) {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'cr-runner-'));
+  const cfgFile = path.join(dir, 'config.json');
+  fs.writeFileSync(cfgFile, JSON.stringify({ stub_port: stub.port, crash }));
+  return new Promise((resolve) => {
+    const child = cp.spawn(process.execPath, [CHILD, root, cfgFile], { stdio: ['ignore', 'pipe', 'pipe'], env: { ...process.env, ANTHROPIC_API_KEY: FAKE_KEY, OPENAI_API_KEY: '', GEMINI_API_KEY: '', GOOGLE_API_KEY: '' } });
+    let out = '';
+    let err = '';
+    child.stdout.on('data', (d) => { out += d; });
+    child.stderr.on('data', (d) => { err += d; });
+    const onCall = () => child.kill('SIGKILL');
+    if (killOnCall) stub.server.once('call', onCall);
+    child.on('exit', (code, signal) => {
+      stub.server.removeListener('call', onCall);
+      fs.rmSync(dir, { recursive: true, force: true });
+      let json = null;
+      try { json = JSON.parse(out); } catch (_) { /* killed */ }
+      resolve({ code, signal, out: json, err });
+    });
+  });
+}
+
+async function paidRun(t, label, budget = { per_run_usd: 5, daily_usd: 20, monthly_usd: 100 }) {
+  const { root, cleanup } = tempWorkspace(label);
+  t.after(cleanup);
+  const prev = process.env.ANTHROPIC_API_KEY;
+  process.env.ANTHROPIC_API_KEY = FAKE_KEY;
+  t.after(() => { if (prev === undefined) delete process.env.ANTHROPIC_API_KEY; else process.env.ANTHROPIC_API_KEY = prev; });
+  let ws = openWorkspace({ root, actor: 'test' });
+  const pid = addFixtureProject(ws).project_id;
+  ws = configure(root, { providers: { claude: CLAUDE }, budget, max_output_tokens: 8000, max_attempts: 2, timeout_seconds: 30 });
+  assert.equal(research.providerStatus(ws).claude.mode, 'api');
+  const run = research.createRun(ws, { project_id: pid, providers: ['claude'] });
+  assert.equal(run.run.jobs.claude.state, 'queued');
+  const text = mockReport(ws, 'claude', run.run).replace('FICTIONAL demo fixture standing in for Claude', 'Claude (Anthropic)');
+  const stub = await stubProvider();
+  t.after(() => stub.close());
+  stub.set(() => ({ status: 200, json: claudeAnswer(text) }));
+  const job = () => research.loadRun(ws, pid, run.run_id).jobs.claude;
+  const reports = () => indexer.projectDetail(ws, pid).reports.filter((r) => r.provenance.research_run_id === run.run_id);
+  const spent = () => research.spendSoFar(ws, new Date(), { runId: run.run_id }).run;
+  return { root, ws, pid, run, text, stub, job, reports, spent };
+}
+
+test('V2-003 window 1: killed after the reservation, before the dispatch marker: released and sent once on restart', async (t) => {
+  const c = await paidRun(t, 'w1');
+  const first = await runner(c.root, c.stub, { crash: { op: 'research_admit', when: 'after' } });
+  assert.equal(first.signal || first.code !== 0 ? 'killed' : 'ran', 'killed');
+  assert.equal(c.stub.calls.length, 0);
+  assert.equal(c.job().state, 'dispatching');
+  assert.equal(c.job().attempts[0].phase, 'reserved');
+  assert.ok(c.spent() > 0, 'the reservation counts while it is open');
+  const second = await runner(c.root, c.stub);
+  assert.equal(second.code, 0, second.err);
+  assert.equal(c.stub.calls.length, 1, 'sent exactly once');
+  const j = c.job();
+  assert.equal(j.state, 'completed');
+  assert.deepEqual(j.attempts.map((a) => a.phase), ['not_sent', 'imported']);
+  assert.equal(c.reports().length, 1);
+  assert.equal(c.spent(), j.attempts[1].cost_actual_usd, 'the released reservation counts nothing');
+  const lines = readJsonLines(c.ws.abs('logs/research-spend.jsonl'));
+  assert.ok(lines.some((l) => l.attempt === 1 && l.kind === 'release' && l.actual_usd === 0), 'older code reading the ledger also counts $0 for attempt 1');
+});
+
+test('V2-003 window 2: killed after the dispatch marker, before the request: held as uncertain, never sent by itself', async (t) => {
+  const c = await paidRun(t, 'w2');
+  await runner(c.root, c.stub, { crash: { op: 'fetch', when: 'before' } });
+  assert.equal(c.stub.calls.length, 0, 'the request never left');
+  for (let i = 0; i < 2; i++) {
+    const r = await runner(c.root, c.stub);
+    assert.equal(r.code, 0, r.err);
+  }
+  assert.equal(c.stub.calls.length, 0, 'restarts never send it');
+  const j = c.job();
+  assert.equal(j.state, 'uncertain');
+  assert.equal(j.attempts.length, 1);
+  assert.equal(j.attempts[0].phase, 'uncertain');
+  assert.match(j.error, /may have reached the provider|may have been billed/);
+  const reserved = j.attempts[0].reserved_usd;
+  assert.equal(c.spent(), reserved, 'counted at its reservation until reconciled');
+  // The owner checks the provider's usage page and records "not charged".
+  const rec = research.reconcileAttempt(c.ws, c.pid, c.run.run_id, 'claude', { not_charged: true, reason: 'test: usage page shows no request' });
+  assert.equal(rec.status, 'saved');
+  assert.equal(c.spent(), 0);
+  assert.equal(c.job().state, 'failed');
+  assert.equal(c.job().attempts[0].phase, 'reconciled');
+  assert.throws(() => research.reconcileAttempt(c.ws, c.pid, c.run.run_id, 'claude', { attempt: 1, charged_usd: 0.5, reason: 'changed my mind' }), (e) => e.code === 'CONFLICT');
+});
+
+test('V2-003 window 3: killed while the provider has the request: uncertain, kept, and only an explicit retry asks again', async (t) => {
+  const c = await paidRun(t, 'w3');
+  c.stub.set(() => 'hang');
+  const first = await runner(c.root, c.stub, { killOnCall: true });
+  assert.ok(first.signal || first.code !== 0, 'killed mid-request');
+  assert.equal(c.stub.calls.length, 1);
+  c.stub.set(() => ({ status: 200, json: claudeAnswer(c.text) }));
+  await runner(c.root, c.stub);
+  await runner(c.root, c.stub);
+  assert.equal(c.stub.calls.length, 1, 'no automatic second request');
+  let j = c.job();
+  assert.equal(j.state, 'uncertain');
+  const held = j.attempts[0].reserved_usd;
+  assert.equal(c.spent(), held);
+  // An explicit retry: a new attempt, reserved separately; the old one still counts.
+  const retry = research.retryJob(c.ws, c.pid, c.run.run_id, 'claude');
+  assert.match(retry.message, /stays counted/);
+  const again = await runner(c.root, c.stub);
+  assert.equal(again.code, 0, again.err);
+  assert.equal(c.stub.calls.length, 2);
+  j = c.job();
+  assert.equal(j.state, 'completed');
+  assert.deepEqual(j.attempts.map((a) => a.phase), ['uncertain', 'imported']);
+  assert.equal(c.spent(), Math.round((held + j.attempts[1].cost_actual_usd) * 10000) / 10000);
+  assert.equal(c.reports().length, 1);
+});
+
+test('V2-003 window 4: killed after the answer arrived, before it was saved: uncertain, never resent by itself', async (t) => {
+  const c = await paidRun(t, 'w4');
+  await runner(c.root, c.stub, { crash: { op: 'research_response', when: 'before' } });
+  assert.equal(c.stub.calls.length, 1);
+  assert.equal(fs.existsSync(c.ws.abs(`projects/${c.pid}/research/${c.run.run_id}/responses/claude-attempt1.json`)), false, 'nothing was saved');
+  await runner(c.root, c.stub);
+  await runner(c.root, c.stub);
+  assert.equal(c.stub.calls.length, 1);
+  assert.equal(c.job().state, 'uncertain');
+  assert.equal(c.reports().length, 0);
+  assert.equal(c.spent(), c.job().attempts[0].reserved_usd);
+});
+
+test('V2-003 window 5: killed after the answer and its pointer were saved: imported on restart without a new request', async (t) => {
+  const c = await paidRun(t, 'w5');
+  await runner(c.root, c.stub, { crash: { op: 'research_response', when: 'after' } });
+  assert.equal(c.stub.calls.length, 1);
+  const respAbs = c.ws.abs(`projects/${c.pid}/research/${c.run.run_id}/responses/claude-attempt1.json`);
+  const savedBefore = fs.readFileSync(respAbs);
+  const r = await runner(c.root, c.stub);
+  assert.equal(r.code, 0, r.err);
+  await runner(c.root, c.stub);
+  assert.equal(c.stub.calls.length, 1, 'no second request');
+  const a = c.job().attempts[0];
+  const j = c.job();
+  assert.equal(j.state, 'completed');
+  assert.equal(j.attempts.length, 1);
+  assert.equal(j.attempts[0].phase, 'imported');
+  assert.equal(c.reports().length, 1);
+  assert.ok(fs.readFileSync(respAbs).equals(savedBefore), 'the saved original is unchanged');
+  assert.equal(a.response_path, `projects/${c.pid}/research/${c.run.run_id}/responses/claude-attempt1.json`);
+  assert.equal(c.spent(), j.attempts[0].cost_actual_usd);
+});
+
+// The state an older runner leaves when it dies between saving an answer and
+// recording a pointer to it (audit V2-003 reproduction): job "running", the
+// attempt unfinished, the answer at its deterministic path.
+function legacyCrashState(c, { tamper = false } = {}) {
+  const runRel = `projects/${c.pid}/research/${c.run.run_id}/run.json`;
+  const respRel = `projects/${c.pid}/research/${c.run.run_id}/responses/claude-attempt1.json`;
+  const startedAt = new Date().toISOString();
+  const payload = {
+    schema_version: 'cr.research-response.v1',
+    run_id: c.run.run_id,
+    provider: 'claude',
+    attempt: 1,
+    started_at: startedAt,
+    finished_at: new Date().toISOString(),
