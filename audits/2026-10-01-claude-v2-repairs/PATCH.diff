+++ b/dashboard/tests/children/child-v2-research.js
@@ -0,0 +1,31 @@
+'use strict';
+// Child runner for V2-003/V2-004 crash and concurrency tests.
+//   node child-v2-research.js <root> <crashAt|none> <countFile> [delayMs] [goFile]
+// crashAt: a research checkpoint name, or "stub-receipt" (the stub receives the
+// request and the process dies before any answer returns).
+const fs = require('fs');
+const path = require('path');
+const base = path.resolve(__dirname, '..', '..');
+const [root, crashAt, countFile, delayMs, goFile] = process.argv.slice(2);
+const research = require(path.join(base, 'core', 'research'));
+const { makeFetch } = require('./v2-stub');
+const ws = require(path.join(base, 'core', 'workspace')).openWorkspace({ root, actor: `v2-child-${process.pid}` });
+
+(async () => {
+  if (goFile) while (!fs.existsSync(goFile)) await new Promise((r) => setTimeout(r, 5));
+  research.hooks.checkpoint = (name) => {
+    if (name === crashAt) process.exit(77);
+  };
+  const runFor = (provider) => {
+    for (const p of require(path.join(base, 'core', 'projects')).listProjects(ws)) {
+      for (const r of research.listRuns(ws, p.project_id)) if (r.jobs[provider] && ['running', 'queued'].includes(r.jobs[provider].state)) return r;
+    }
+    return research.listRuns(ws, require(path.join(base, 'core', 'projects')).listProjects(ws)[0].project_id)[0];
+  };
+  const fetchImpl = makeFetch({ countFile, ws, runFor, delayMs: Number(delayMs || 0), onReceipt: () => { if (crashAt === 'stub-receipt') process.exit(77); } });
+  const out = await research.runDueJobs(ws, { trigger: 'v2-child', fetchImpl });
+  process.stdout.write(JSON.stringify(out.results.map((r) => r.status)));
+})().catch((err) => {
+  process.stderr.write(String(err && err.stack));
+  process.exit(1);
+});
