@@ -0,0 +1,27 @@
+'use strict';
+// Test child for V2-001: commits two record files together and, after the
+// FIRST file is in place, either holds (until a release file appears) or dies.
+//   node child-v2-writer.js <root> <hold|die> <signalDir>
+const fs = require('fs');
+const path = require('path');
+const base = path.resolve(__dirname, '..', '..');
+const [root, mode, signalDir] = process.argv.slice(2);
+const ops = require(path.join(base, 'core', 'ops'));
+const { sleepSync } = require(path.join(base, 'core', 'fsx'));
+const ws = require(path.join(base, 'core', 'workspace')).openWorkspace({ root, actor: `v2-writer-${mode}`, recover: false });
+const firstTarget = ws.abs('portfolio/limits.json');
+const rename = fs.renameSync;
+fs.renameSync = function heldRename(from, to) {
+  const r = rename.call(fs, from, to);
+  if (to === firstTarget && String(from).includes('staging')) {
+    fs.writeFileSync(path.join(signalDir, 'writer-ready'), String(process.pid));
+    if (mode === 'die') process.exit(77);
+    while (!fs.existsSync(path.join(signalDir, 'writer-release'))) sleepSync(20);
+  }
+  return r;
+};
+ops.runOp(ws, { type: 'v2_pair', summary: 'two-file commit' }, (op) => {
+  op.writeJson('portfolio/limits.json', { v: 'new' });
+  op.writeJson('portfolio/assets.json', { assets: [], v: 'new' });
+});
+process.stdout.write('committed');
diff --git a/dashboard/tests/children/v2-stub.js b/dashboard/tests/children/v2-stub.js
new file mode 100644
index 0000000..b19ea07
--- /dev/null
+++ b/dashboard/tests/children/v2-stub.js
@@ -0,0 +1,54 @@
+'use strict';
+// Local provider stubs for V2-003/004/005 tests. Nothing here reaches a network:
+// every request is answered (or crashed) in-process, and each dispatch is
+// counted in a file so a parent process can see dispatches made by children.
+const fs = require('fs');
+const path = require('path');
+const base = path.resolve(__dirname, '..', '..');
+const { mockReport } = require(path.join(base, 'core', 'demo'));
+
+const VENDOR = { claude: 'Claude (Anthropic)', chatgpt: 'ChatGPT (OpenAI)', gemini: 'Gemini (Google)' };
+const URLS = { 'https://api.anthropic.com/v1/messages': 'claude', 'https://api.openai.com/v1/responses': 'chatgpt' };
+
+function providerOf(url) {
+  if (URLS[url]) return URLS[url];
+  if (String(url).startsWith('https://generativelanguage.googleapis.com/')) return 'gemini';
+  throw new Error(`stub: unexpected URL ${url}`);
+}
+
+function answerText(ws, provider, run) {
+  return mockReport(ws, provider, run).replace(/FICTIONAL demo fixture standing in for [A-Za-z]+/, VENDOR[provider]);
+}
+
+// usage: { input_tokens, output_tokens, search_calls }
+function body(provider, text, usage) {
+  if (provider === 'claude') return { id: 'msg_stub', model: 'stub-model', stop_reason: 'end_turn', content: [{ type: 'text', text }], usage: { input_tokens: usage.input_tokens, output_tokens: usage.output_tokens, server_tool_use: { web_search_requests: usage.search_calls } } };
+  if (provider === 'chatgpt') return { id: 'resp_stub', model: 'stub-model', status: 'completed', output_text: text, output: Array.from({ length: usage.search_calls }, () => ({ type: 'web_search_call' })), usage: { input_tokens: usage.input_tokens, output_tokens: usage.output_tokens } };
+  return { responseId: 'gem_stub', modelVersion: 'stub-model', candidates: [{ finishReason: 'STOP', content: { parts: [{ text }] }, groundingMetadata: { webSearchQueries: Array.from({ length: usage.search_calls }, (_, i) => `q${i}`) } }], usageMetadata: { promptTokenCount: usage.input_tokens, candidatesTokenCount: usage.output_tokens } };
+}
+
+// opts: { countFile, ws, runFor(provider) -> run, usage, delayMs, onReceipt(provider, request), captured: [] }
+function makeFetch(opts) {
+  return async (url, init) => {
+    const provider = providerOf(url);
+    const request = JSON.parse(init.body);
+    if (opts.captured) opts.captured.push({ provider, url, request });
+    if (opts.countFile) fs.appendFileSync(opts.countFile, `${provider}\n`);
+    if (opts.onReceipt) opts.onReceipt(provider, request);
+    if (opts.delayMs) await new Promise((r) => setTimeout(r, opts.delayMs));
+    const run = opts.runFor(provider);
+    const usage = typeof opts.usage === 'function' ? opts.usage(provider) : opts.usage || { input_tokens: 0, output_tokens: 1000, search_calls: 0 };
+    const json = body(provider, answerText(opts.ws, provider, run), usage);
+    return { ok: true, status: 200, headers: { get: (k) => (k === 'request-id' || k === 'x-request-id' ? `req_stub_${provider}` : null) }, text: async () => JSON.stringify(json) };
+  };
+}
+
+function dispatches(countFile) {
+  try {
+    return fs.readFileSync(countFile, 'utf8').split('\n').filter(Boolean).length;
+  } catch (_) {
+    return 0;
+  }
+}
+
+module.exports = { makeFetch, dispatches, answerText };
diff --git a/dashboard/tests/v2-reads.test.js b/dashboard/tests/v2-reads.test.js
