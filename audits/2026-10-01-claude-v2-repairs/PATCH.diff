index 0000000..ccb963e
--- /dev/null
+++ b/dashboard/tests/v2-reads.test.js
@@ -0,0 +1,228 @@
+'use strict';
+// V2-001: coherent reads at PRODUCTION defaults. A reader never returns a
+// mixture of two generations: it returns one verified generation, the server
+// keeps serving its previous verified snapshot with an honest status, or the
+// read fails with a bounded READ_BUSY. No test here raises the retry count.
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('fs');
+const os = require('os');
+const path = require('path');
+const cp = require('child_process');
+const { tempWorkspace, addFixtureProject } = require('./helpers');
+const ops = require('../core/ops');
+const { openWorkspace } = require('../core/workspace');
+const indexer = require('../core/indexer');
+const exporter = require('../core/exporter');
+
+const CHILD = path.join(__dirname, 'children', 'child-v2-writer.js');
+const readPair = (ws) => () => [JSON.parse(fs.readFileSync(ws.abs('portfolio/limits.json'), 'utf8')).v, JSON.parse(fs.readFileSync(ws.abs('portfolio/assets.json'), 'utf8')).v];
+const rawPair = (ws) => readPair(ws)();
+const wait = (ms) => new Promise((r) => setTimeout(r, ms));
+
+function seed(ws) {
+  ops.runOp(ws, { type: 'seed', summary: 'seed pair' }, (op) => {
+    op.writeJson('portfolio/limits.json', { v: 'old' });
+    op.writeJson('portfolio/assets.json', { assets: [], v: 'old' });
+  });
+}
+
+async function startWriter(root, mode) {
+  const sig = fs.mkdtempSync(path.join(os.tmpdir(), 'cr-v2sig-'));
+  const child = cp.spawn(process.execPath, [CHILD, root, mode, sig], { stdio: ['ignore', 'pipe', 'pipe'] });
+  let stderr = '';
+  child.stderr.on('data', (d) => { stderr += d; });
+  const exited = new Promise((resolve) => child.on('exit', (code) => resolve(code)));
+  const t0 = Date.now();
+  while (!fs.existsSync(path.join(sig, 'writer-ready'))) {
+    if (Date.now() - t0 > 15000) throw new Error(`writer never became ready: ${stderr}`);
+    await wait(20);
+  }
+  return { sig, exited, release: () => fs.writeFileSync(path.join(sig, 'writer-release'), '1'), stderr: () => stderr };
+}
+
+async function startServer(root) {
+  const ws = openWorkspace({ root, actor: 'dashboard' });
+  const port = 20000 + Math.floor(Math.random() * 30000);
+  const srv = await require('../server').start(ws, { port, quiet: true });
+  const get = async (p) => {
+    const res = await fetch(`${srv.url.replace(/\/$/, '')}${p}`, { headers: { 'x-cr-token': srv.token } });
+    const type = res.headers.get('content-type') || '';
+    return { status: res.status, retryAfter: res.headers.get('retry-after'), body: type.includes('json') ? await res.json() : await res.text() };
+  };
+  return { srv, get };
+}
+
+async function until(fn, ms, label) {
+  const t0 = Date.now();
+  for (;;) {
+    const v = await fn();
+    if (v) { if (process.env.CR_TIMING) console.log(`until ${label}: ${Date.now() - t0} ms`); return v; }
+    if (Date.now() - t0 > ms) throw new Error(`timed out waiting for ${label}`);
+    await wait(100);
+  }
+}
+
+test('V2-001: a writer held between its two renames beyond the default retry window gives READ_BUSY, never [new, old]', async (t) => {
+  const { ws, root, cleanup } = tempWorkspace('v2-held');
+  t.after(cleanup);
+  seed(ws);
+  const w = await startWriter(root, 'hold');
+  try {
+    assert.deepEqual(rawPair(ws), ['new', 'old'], 'precondition: the files on disk really are mixed right now');
+    const t0 = Date.now();
+    let result = null;
+    let error = null;
+    try {
+      result = ops.readConsistent(ws, readPair(ws)); // production defaults
+    } catch (err) {
+      error = err;
+    }
+    const waited = Date.now() - t0;
+    assert.equal(result, null, `a mixed or partial result was returned: ${JSON.stringify(result)}`);
+    assert.equal(error && error.code, 'READ_BUSY');
+    assert.equal(error.details.reason, 'commit_in_progress');
+    assert.equal(error.details.attempts, ops.READ_ATTEMPTS);
+    assert.ok(waited >= 900 && waited < 5000, `bounded wait, was ${waited} ms`);
+    assert.throws(() => indexer.buildIndex(ws), (e) => e.code === 'READ_BUSY', 'the dashboard index is not built from a mixture');
+  } finally {
+    w.release();
+  }
+  assert.equal(await w.exited, 0, w.stderr());
+  assert.deepEqual(ops.readConsistent(ws, readPair(ws)), ['new', 'new'], 'after release: one complete new generation');
+  assert.equal(indexer.buildIndex(ws).integrity.status, 'verified');
+});
+
+test('V2-001: a writer that died between renames is never read through; recovery completes it', async (t) => {
+  const { ws, root, cleanup } = tempWorkspace('v2-died');
+  t.after(cleanup);
+  seed(ws);
+  const w = await startWriter(root, 'die');
+  assert.equal(await w.exited, 77);
+  assert.deepEqual(rawPair(ws), ['new', 'old'], 'precondition: the interrupted commit left mixed files');
+  const t0 = Date.now();
+  assert.throws(() => ops.readConsistent(ws, readPair(ws)), (e) => e.code === 'READ_BUSY' && e.details.reason === 'recovery_needed' && e.details.recovery_needed === true);
+  assert.ok(Date.now() - t0 < 1500, 'no pointless waiting when no writer is alive');
+  // A CLI-style reader (patience + recovery) finishes the commit and then reads.
+  const cliWs = openWorkspace({ root, actor: 'cli', recover: false });
+  cliWs.readPolicy = { patienceMs: 5000, recover: true };
+  assert.deepEqual(ops.readConsistent(cliWs, readPair(cliWs)), ['new', 'new']);
+  assert.equal(ops.readGen(ws).state, 'stable');
+  assert.ok(fs.readFileSync(ws.abs('logs/operations.jsonl'), 'utf8').includes('recovered_forward'), 'roll-forward is journaled');
+});
+
+test('V2-001: an unreadable generation marker is never treated as stable', (t) => {
+  const { ws, cleanup } = tempWorkspace('v2-marker');
+  t.after(cleanup);
+  seed(ws);
+  fs.writeFileSync(ws.abs('.cr/generation.json'), '{"generation": 4, "sta');
+  assert.equal(ops.readGen(ws).state, 'invalid');
+  assert.throws(() => ops.readConsistent(ws, readPair(ws)), (e) => e.code === 'READ_BUSY' && e.details.reason === 'marker_invalid');
+  const out = ops.recover(ws);
+  assert.ok(out.some((r) => r.action === 'marker_repaired'), JSON.stringify(out));
+  assert.equal(ops.readGen(ws).state, 'stable');
+  assert.deepEqual(ops.readConsistent(ws, readPair(ws)), ['old', 'old']);
+  // While a live owner holds the lock, an unreadable marker means "busy", not "repair".
+  fs.writeFileSync(ws.abs('.cr/generation.json'), 'garbage');
+  ops.withLock(openWorkspace({ root: ws.root, actor: 'other', recover: false }), 'hold', () => {
+    assert.throws(() => ops.readConsistent(ws, readPair(ws)), (e) => e.code === 'READ_BUSY' && e.details.reason === 'commit_in_progress');
+  });
+});
