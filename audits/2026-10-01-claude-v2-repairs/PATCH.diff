index 0000000..cc14fc0
--- /dev/null
+++ b/dashboard/tests/v2-restore.test.js
@@ -0,0 +1,165 @@
+'use strict';
+// V2-002: every package and sealed-backup entry is checked before anything is
+// created or written. Payloads here are correctly hashed (and resealed) so the
+// only thing that can stop them is the path check. Every adversarial output
+// stays inside a parent folder this test owns.
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('fs');
+const os = require('os');
+const path = require('path');
+const crypto = require('crypto');
+const { tempWorkspace, addFixtureProject, importAllFixtures, hashTree } = require('./helpers');
+const exporter = require('../core/exporter');
+const pf = require('../core/portfolio');
+const { portableRel } = require('../core/workspace');
+
+const sha = (b) => crypto.createHash('sha256').update(b).digest('hex');
+const sealOf = (items) => sha(JSON.stringify(items.map((i) => [i.path, i.bytes, i.sha256])));
+
+function populated(label) {
+  const t = tempWorkspace(label);
+  addFixtureProject(t.ws);
+  importAllFixtures(t.ws);
+  pf.addAccount(t.ws, { account_id: 'a', name: 'Fictional exchange', kind: 'exchange' });
+  pf.addTransactions(t.ws, [{ type: 'buy', date: '2026-09-01', account_id: 'a', asset_id: 'bitcoin', quantity: 1.5, price_usd: 10 }]);
+  return t;
+}
+
+function ownedParent(t, label) {
+  const parent = fs.mkdtempSync(path.join(os.tmpdir(), `cr-v2-${label}-`));
+  t.after(() => fs.rmSync(parent, { recursive: true, force: true }));
+  fs.writeFileSync(path.join(parent, 'sentinel.txt'), 'untouched');
+  return parent;
+}
+
+const PAYLOADS = [
+  '..\\escaped.txt',
+  '../escaped.txt',
+  'projects\\..\\..\\escaped.txt',
+  'projects/x/../../../escaped.txt',
+  'C:\\escaped.txt',
+  'C:escaped.txt',
+  'c:/escaped.txt',
+  '\\\\server\\share\\escaped.txt',
+  '//server/share/escaped.txt',
+  '\\escaped.txt',
+  '/escaped.txt',
+  'projects/a\u0000b.txt',
+  'projects/con.txt',
+  'projects/trailing. ',
+  'projects/x.json:stream',
+];
+
+test('V2-002: the portable path rule rejects traversal, rooted, drive, UNC, NUL, device and aliased names on every platform', () => {
+  for (const p of PAYLOADS) assert.throws(() => portableRel(p), (e) => e.code === 'BAD_PATH', p);
+  for (const ok of ['workspace.json', 'projects/example/report.md', 'inbox/claude/My Report (v2).md', 'Open Dashboard.cmd']) assert.equal(portableRel(ok).rel, ok);
+  // What the old check missed: on Windows these join outside the destination.
+  assert.ok(path.win32.relative('C:\\dest', path.win32.join('C:\\dest', '..\\escaped.txt')).startsWith('..'));
+});
+
+test('V2-002: a legitimate complete package still round-trips hashes and record totals', (t) => {
+  const { ws, cleanup } = populated('v2-pkg-ok');
+  t.after(cleanup);
+  const pkg = exporter.exportPackage(ws);
+  const parent = ownedParent(t, 'pkg-ok');
+  const res = exporter.restorePackage(JSON.parse(JSON.stringify(pkg)), path.join(parent, 'ws'));
+  assert.equal(res.status, 'restored_and_verified', JSON.stringify(res));
+  const restored = hashTree(path.join(parent, 'ws'));
+  for (const f of pkg.files) assert.equal(restored[f.path.split('/').join(path.sep)], f.sha256, f.path);
+  assert.equal(res.reconciliation, 'record totals match the package');
+});
+
+test('V2-002: correctly hashed package entries with unsafe or colliding paths fail before the destination is created', (t) => {
+  const { ws, cleanup } = populated('v2-pkg-bad');
+  t.after(cleanup);
+  const pkg = exporter.exportPackage(ws);
+  const parent = ownedParent(t, 'pkg-bad');
+  const pid = 'example-payfi-fictional';
+  const cases = [
+    ...PAYLOADS.map((p) => ({ label: p, entry: p })),
+    { label: 'case-insensitive duplicate', entry: 'portfolio/Transactions.json' },
+    { label: 'backslash duplicate', entry: `projects\\${pid}\\project.json` },
+    { label: 'file that is also a folder', entry: `projects/${pid}/project.json/inner.txt` },
+    { label: 'outside record areas', entry: 'dashboard/server.js' },
+  ];
+  cases.forEach((c, i) => {
+    const content = `FICTIONAL payload ${i}\n`;
+    const bad = { path: c.entry, bytes: Buffer.byteLength(content), sha256: sha(Buffer.from(content)), encoding: 'utf8', content };
+    const copy = JSON.parse(JSON.stringify(pkg));
+    copy.files.push(bad); // last: every legitimate entry comes first
+    const dest = path.join(parent, `dest-${i}`);
+    assert.throws(() => exporter.restorePackage(copy, dest), (e) => e.code === 'UNSAFE_RESTORE' && e.details.written === 0 && e.details.rejected.length === 1, c.label);
+    assert.ok(!fs.existsSync(dest), `${c.label}: destination not created`);
+  });
+  assert.deepEqual(fs.readdirSync(parent).sort(), ['sentinel.txt'], 'nothing written beside the destinations');
+  assert.equal(fs.readFileSync(path.join(parent, 'sentinel.txt'), 'utf8'), 'untouched');
+  // A late entry with a wrong hash also stops the whole restore before writing.
+  const tampered = JSON.parse(JSON.stringify(pkg));
+  tampered.files[tampered.files.length - 1].content += 'x';
+  assert.throws(() => exporter.restorePackage(tampered, path.join(parent, 'late-bad')), (e) => e.code === 'UNSAFE_RESTORE' && /hash mismatch/.test(e.message));
+  assert.ok(!fs.existsSync(path.join(parent, 'late-bad')));
+});
+
+function resealedBackup(ws, name, extraItems) {
+  const dir = path.join(ws.root, 'backups', 'snapshots', name);
+  const m = JSON.parse(fs.readFileSync(path.join(dir, 'MANIFEST.json'), 'utf8'));
+  m.items.push(...extraItems);
+  m.files = m.items.length;
+  m.seal = sealOf(m.items); // the documented, unkeyed seal: anyone can recompute it
+  fs.writeFileSync(path.join(dir, 'MANIFEST.json'), JSON.stringify(m, null, 2));
+  return { dir, m };
+}
+
+test('V2-002: a legitimate sealed backup still restores cleanly with matching hashes and totals', (t) => {
+  const { ws, cleanup } = populated('v2-bk-ok');
+  t.after(cleanup);
+  const b = exporter.createBackup(ws, { reason: 'manual' });
+  assert.equal(exporter.verifyBackup(ws, b.name).ok, true);
+  const parent = ownedParent(t, 'bk-ok');
+  const r = exporter.restoreBackup(ws, b.name, { to: path.join(parent, 'ws') });
+  assert.equal(r.status, 'restored_and_verified', JSON.stringify(r));
+  assert.equal(r.reconciliation, 'record totals match the backup');
+});
+
+test('V2-002: a resealed backup with escaping, linked or colliding items fails verification and restores nothing', (t) => {
+  const { ws, root, cleanup } = populated('v2-bk-bad');
+  t.after(cleanup);
+  const parent = ownedParent(t, 'bk-bad');
+  const content = Buffer.from('FICTIONAL escaped backup payload\n');
+  const item = (p) => ({ path: p, bytes: content.length, sha256: sha(content) });
+  const variants = [
+    { label: 'forward-slash traversal (source and destination escape on any OS)', items: [item('../escaped-backup.txt')], plant: (dir) => fs.writeFileSync(path.join(dir, 'escaped-backup.txt'), content) },
+    { label: 'Windows backslash traversal', items: [item('..\\escaped-backup.txt')], plant: (dir) => fs.writeFileSync(path.join(dir, 'files', '..\\escaped-backup.txt'), content) },
+    { label: 'drive path', items: [item('C:\\escaped-backup.txt')], plant: () => {} },
+    { label: 'UNC path', items: [item('\\\\server\\share\\escaped.txt')], plant: () => {} },
+    { label: 'case-insensitive duplicate', items: [item('Portfolio/transactions.json'.replace('Portfolio', 'portfolio').replace('transactions', 'Transactions'))], plant: (dir) => fs.writeFileSync(path.join(dir, 'files', 'portfolio', 'Transactions.json'), content) },
+    {
+      label: 'link that points outside the backup',
+      items: [item('logs/linked.txt')],
+      plant: (dir) => {
+        fs.writeFileSync(path.join(parent, 'outside-target.txt'), content);
+        fs.symlinkSync(path.join(parent, 'outside-target.txt'), path.join(dir, 'files', 'logs', 'linked.txt'));
+      },
+    },
+  ];
+  variants.forEach((v, i) => {
+    const b = exporter.createBackup(ws, { reason: `adv${i}` });
+    const { dir } = resealedBackup(ws, b.name, v.items);
+    v.plant(dir);
+    const verified = exporter.verifyBackup(ws, b.name);
+    assert.equal(verified.ok, false, `${v.label}: must not verify`);
+    assert.ok(verified.unsafe && verified.unsafe.length >= 1, `${v.label}: ${JSON.stringify(verified)}`);
+    const dest = path.join(parent, `dest-${i}`);
+    assert.throws(() => exporter.restoreBackup(ws, b.name, { to: dest }), /did not verify/, v.label);
+    assert.ok(!fs.existsSync(dest), `${v.label}: destination not created`);
+    const before = fs.readdirSync(path.join(root, 'backups', 'snapshots')).length;
+    assert.throws(() => exporter.restoreBackup(ws, b.name, { overlay: true, confirm: true }), (e) => ['INVALID', 'UNSAFE_RESTORE'].includes(e.code), `${v.label}: overlay refused`);
+    assert.throws(() => exporter.restoreBackup(ws, b.name, { pointInTime: true }), (e) => ['INVALID', 'UNSAFE_RESTORE'].includes(e.code), `${v.label}: point-in-time refused`);
+    assert.equal(fs.readdirSync(path.join(root, 'backups', 'snapshots')).length, before, 'no pre-restore backup was even started');
+  });
+  assert.ok(!fs.existsSync(path.join(parent, 'escaped-backup.txt')), 'nothing escaped beside the destinations');
+  assert.ok(!fs.existsSync(path.join(root, 'backups', 'escaped-backup.txt')));
+  assert.equal(fs.readFileSync(path.join(parent, 'sentinel.txt'), 'utf8'), 'untouched');
+});
