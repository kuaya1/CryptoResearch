+test('V2-003: a refused connection was never sent (released, retried); a reset or timeout may have been (held)', async (t) => {
+  const ctx = setup(t, 'v2-network', { providers: { claude: DOLLAR }, budget, timeout_seconds: 1 });
+  const fail = (code) => async () => { fs.appendFileSync(ctx.countFile, 'x\n'); throw Object.assign(new TypeError('fetch failed'), { cause: Object.assign(new Error(code), { code }) }); };
+  await research.runDueJobs(ctx.ws, { trigger: 'test', fetchImpl: fail('ECONNREFUSED') });
+  let job = research.loadRun(ctx.ws, ctx.pid, ctx.run.run_id).jobs.claude;
+  assert.equal(job.state, 'queued', 'provably unsent: an ordinary retry');
+  assert.equal(research.spendSoFar(ctx.ws, new Date(), { runId: ctx.run.run_id }).run, 0, 'its reservation was released');
+  await research.runDueJobs(ctx.ws, { trigger: 'test', fetchImpl: fail('ECONNRESET') });
+  job = research.loadRun(ctx.ws, ctx.pid, ctx.run.run_id).jobs.claude;
+  assert.equal(job.state, 'needs_reconciliation', 'a reset connection may have reached the provider');
+  assert.equal(research.spendSoFar(ctx.ws, new Date(), { runId: ctx.run.run_id }).run, 1, 'its reservation stays counted');
+  research.retryJob(ctx.ws, ctx.pid, ctx.run.run_id, 'claude', { acceptUncertain: true });
+  await research.runDueJobs(ctx.ws, { trigger: 'test', fetchImpl: (url, init) => new Promise((resolve, reject) => { fs.appendFileSync(ctx.countFile, 'x\n'); init.signal.addEventListener('abort', () => reject(init.signal.reason)); }) });
+  job = research.loadRun(ctx.ws, ctx.pid, ctx.run.run_id).jobs.claude;
+  assert.equal(job.state, 'needs_reconciliation', 'a timed-out request is held, not retried automatically');
+  assert.equal(job.attempts[job.attempts.length - 1].dispatch_state, 'uncertain');
+  await research.runDueJobs(ctx.ws, { trigger: 'test', fetchImpl: fail('ECONNREFUSED') });
+  assert.equal(dispatches(ctx.countFile), 3, 'nothing re-sent after the timeout');
+});
diff --git a/dashboard/tests/v2-restore.test.js b/dashboard/tests/v2-restore.test.js
