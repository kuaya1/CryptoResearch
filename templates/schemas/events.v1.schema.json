{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cr.events.v1",
  "title": "Review calendar entries (projects/<project_id>/events.json or portfolio/events.json)",
  "description": "User-defined reviews, catalysts, unlock reminders and alerts. Dates are calendar dates in America/New_York. Catalysts and unlocks that come from reports are read from the reports and are not copied here.",
  "type": "object",
  "required": ["schema_version", "events"],
  "properties": {
    "schema_version": { "const": "cr.events.v1" },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_id", "type", "title", "status", "created_at"],
        "properties": {
          "event_id": { "type": "string" },
          "type": { "enum": ["review", "catalyst", "unlock", "alert", "invalidator_check", "other"] },
          "title": { "type": "string" },
          "due_date": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "timezone": { "const": "America/New_York" },
          "status": { "enum": ["open", "done", "dismissed"] },
          "note": { "type": ["string", "null"] },
          "alert": {
            "type": ["object", "null"],
            "properties": {
              "kind": { "enum": ["price_below", "price_above"] },
              "threshold_usd": { "type": "number" }
            }
          },
          "created_at": { "type": "string" },
          "created_via": { "type": ["string", "null"] },
          "completed_at": { "type": ["string", "null"] },
          "source_request_text": { "type": ["string", "null"] }
        }
      }
    }
  }
}
