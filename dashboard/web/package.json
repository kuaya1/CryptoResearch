{
  "name": "cryptoresearch-web",
  "private": true,
  "type": "module",
  "description": "The desk's browser app (React + Vite). Its production build is committed to ../public/app, which the Node server serves; the server itself needs no npm packages.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/stamp.mjs",
    "check": "node scripts/check.mjs && node scripts/regress.mjs",
    "check:dev": "node scripts/regress.mjs --dev"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-tabs": "1.1.21",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "vite": "8.3.3"
  },
  "engines": {
    "node": "24.x"
  },
  "volta": {
    "node": "24.21.0"
  }
}
