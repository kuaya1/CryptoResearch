# ---------------------------------------------------------------------------
# Never track, wherever they appear

# Credentials and keys (API keys live outside this folder, in
# %USERPROFILE%\.cryptoresearch\secrets.json or environment variables)
secrets.json
*.secrets.json
.env
.env.*
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
.npmrc
.netrc

# Workspace runtime state, locks, staging and temporary files
.cr/
*.tmp-*
*.stale-*
*.probe

# OS and editor files
Thumbs.db
desktop.ini
.DS_Store
*.swp
*~
